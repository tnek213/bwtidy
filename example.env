## Copy this file to .env next to compose.yaml and change what you need.
## docker compose reads .env by itself, and git ignores it.
## How to run it: docs/how-to/run.md

## The image to run, without the tag. This is the published image. A build from a checkout
## names its image bwtidy:local and does not use it.
BWTIDY_IMAGE=docker.io/tnek213/bwtidy

## The image tag. Pin a version so an update is a decision: change it and run
## docker compose pull && docker compose up -d.
BWTIDY_VERSION=latest

## Where the encrypted backups are kept, mounted at /backups in the container: the named volume
## bwtidy-backups, or a host directory such as another disk, a network share or a directory
## your backup tool reads (like /srv/bwtidy-backups). The file system must let root chown, each
## account's backups belong to its own uid.
BWTIDY_BACKUPS=bwtidy-backups

## The port on the host's 127.0.0.1 that the web page is published on.
BWTIDY_HOST_PORT=8765

## Behind a reverse proxy that terminates TLS: the public host names (comma separated, like
## bwtidy.example.com) that /mcp accepts besides localhost. Leave empty for a local run.
BWTIDY_MCP_HOSTS=

## Set to 1 when the page is served over https, so the cookies are marked Secure.
BWTIDY_SECURE_COOKIES=0

## Most new accounts that wait for their first login. Anyone who reaches the page can add one.
BWTIDY_MAX_PENDING=2

## Most accounts that are open at once, one worker process each.
BWTIDY_MAX_WORKERS=8

## The first uid for the account workers, each account gets the next one.
BWTIDY_UID_BASE=70000

## Servers (comma separated URLs) that skip the check for a public address, like a Vaultwarden
## on your own network. Without it the gateway refuses a server that resolves to a private address.
BWTIDY_ALLOWED_SERVERS=

## A session ends after this many seconds without a heartbeat from the page (at least 60).
## Empty means the default, 120.
BWTIDY_HEARTBEAT_TIMEOUT=

## A session ends after this many seconds without any use. Empty means the default, 7200.
BWTIDY_SESSION_IDLE_TIMEOUT=

## Backup retention: a backup past the newest this many is deleted. Empty means the default, 40.
BWTIDY_BACKUP_KEEP_NEWEST=

## Backup retention: a backup older than this many days is deleted. Empty means the default, 90.
BWTIDY_BACKUP_KEEP_DAYS=

## Backup retention: the newest this many backups are never deleted by the two rules above.
## Empty means the default, 5.
BWTIDY_BACKUP_KEEP_ALWAYS=

## A failed queue entry is deleted this many hours after it failed. Empty means the default, 30.
BWTIDY_FAILED_KEEP_HOURS=

## Usage stats, kept in a file on this machine and never sent anywhere: 1 turns them on. Set
## BWTIDY_STATS_DB to a file on a volume of its own too, like /stats/stats.db with a volume
## mounted at /stats (docs/reference/configuration.md, Usage stats).
BWTIDY_STATS=0
BWTIDY_STATS_DB=
