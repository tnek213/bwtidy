#!/usr/bin/env python3
"""docs-lint: images and links of the markdown files resolve, and the prose follows AGENTS.md.

  scripts/docs-lint

Reads every *.md of the repo (`git ls-files -co --exclude-standard`, so node_modules, .venv
and ignored files never count). Links in fenced code blocks and inline code are skipped, so are
URLs with a scheme (http:, https:, data:, mailto:). A path is resolved relative to the markdown
file that holds it (a leading / is the repo root) after a #fragment or ?query is cut off.

Images: an image link is inline `![alt](path)` or `![alt](path "title")` with any alt text
including none, reference style `![alt][ref]` with its `[ref]: path` definition, or an HTML img
tag's src. It prints `FILE:LINE: missing image PATH` for each link to no file, and
`docs/images/NAME: not linked from any markdown file` for each file in docs/images that no
markdown file links (which markdown file links it does not matter). The alt text is never
checked, an empty one is fine. Images are written by the docs test suite (scripts/docs-shots),
see dev/testing.md.

Page links: every other local link, inline `[text](path)`, reference style `[text][ref]`,
`[ref][]` or `[ref]` with a definition, or an HTML a href, must resolve to a file. It prints
`FILE:LINE: missing link PATH`. A #anchor on a link to a markdown file, or a bare #anchor in the
same file, must match a heading of that file with GitHub's slug rules (lowercase, spaces to
hyphens, punctuation dropped, a -1, -2 suffix for a repeated heading), else
`FILE:LINE: no heading for #ANCHOR in PATH`. An id or name attribute of an HTML tag counts too.

Prose style (AGENTS.md): outside fenced code, inline code, HTML comments, HTML tags, link
targets and URLs, a semicolon, an em dash (U+2014) or ` -- ` used as a dash is reported as
`FILE:LINE: STYLE (AGENTS.md: split the sentence or use a comma, colon or parentheses)`, with
STYLE `semicolon`, `em dash` or `double hyphen as a dash`. The semicolon of an HTML entity
(like `&amp;`) does not count.

Prints nothing and exits 0 when all is well, exits 1 otherwise.
"""

import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parent.parent
IMAGES = "docs/images"

FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
INLINE_CODE = re.compile(r"(?<!`)(`+)(?!`)((?:(?!\n[ \t]*\n).)+?)(?<!`)\1(?!`)", re.DOTALL)
## the alt text may hold one level of brackets, the target is <path with spaces> or a path
## with an optional title after a space
INLINE = re.compile(
    r"!\[(?:[^\[\]]|\[[^\]]*\])*\]\(\s*(?:<([^>\n]*)>|([^\s()]*(?:\([^\s()]*\)[^\s()]*)*))"
)
REFERENCE = re.compile(r"!\[((?:[^\[\]]|\[[^\]]*\])*)\](?:\[([^\]]*)\])?")
DEFINITION = re.compile(r"^ {0,3}\[([^\]]+)\]:[ \t]*(?:<([^>\n]*)>|(\S*))", re.MULTILINE)
IMG_TAG = re.compile(r"<img\b[^>]*?\bsrc\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s\"'>]+))", re.I)
## inline link: the text may hold one level of brackets, the target is as for an image
LINK = re.compile(
    r"\[(?:[^\[\]]|\[[^\]]*\])*\]\(\s*(?:<([^>\n]*)>|([^\s()]*(?:\([^\s()]*\)[^\s()]*)*))"
)
## `[text][ref]`, `[ref][]` and `[ref]`, told from a plain bracket by the definition
BRACKETS = re.compile(r"\[((?:[^\[\]]|\[[^\]]*\])*)\](?:\[([^\]]*)\])?")
A_TAG = re.compile(r"<a\b[^>]*?\bhref\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s\"'>]+))", re.I)
HTML_ID = re.compile(r"\b(?:id|name)\s*=\s*(?:\"([^\"]*)\"|'([^']*)')", re.I)
HEADING = re.compile(r"^ {0,3}#{1,6}(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
SETEXT = re.compile(r"^ {0,3}(?:=+|-+)[ \t]*$")
HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
HTML_TAG = re.compile(r"</?[a-zA-Z][^>]*>|<[a-zA-Z][a-zA-Z0-9+.-]*:[^>\s]*>")
HTML_ENTITY = re.compile(r"&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#[xX][0-9a-fA-F]+);")
BARE_URL = re.compile(r"\b[a-zA-Z][a-zA-Z0-9+.-]*://\S+")
STYLE_HINT = "AGENTS.md: split the sentence or use a comma, colon or parentheses"
SCHEME = re.compile(r"^(?:[a-zA-Z][a-zA-Z0-9+.-]*:|//)")


def blank(text: str) -> str:
    """The text with every character but the newlines replaced by a space."""
    return re.sub(r"[^\n]", " ", text)


def strip_fences(text: str) -> str:
    """The text with fenced code blocks blanked, line numbers kept."""
    lines = text.split("\n")
    fence: str | None = None
    for i, line in enumerate(lines):
        match = FENCE.match(line)
        if fence is None:
            if match:
                fence = match.group(1)
                lines[i] = blank(line)
        else:
            closes = match and match.group(1)[0] == fence[0] and len(match.group(1)) >= len(fence)
            if closes:
                fence = None
            lines[i] = blank(line)
    return "\n".join(lines)


def strip_code(text: str) -> str:
    """The text with fenced code blocks and inline code blanked, line numbers kept."""
    return INLINE_CODE.sub(lambda m: blank(m.group(0)), strip_fences(text))


def image_links(text: str) -> list[tuple[int, str]]:
    """(line, path) of every image link of a markdown text, one entry per link."""
    text = strip_code(text)
    definitions = {
        m.group(1).strip().lower(): m.group(2) or m.group(3) for m in DEFINITION.finditer(text)
    }
    found: list[tuple[int, str]] = []
    inline_spans: list[tuple[int, int]] = []
    for m in INLINE.finditer(text):
        inline_spans.append(m.span())
        found.append((m.start(), m.group(1) if m.group(1) is not None else m.group(2)))
    for m in REFERENCE.finditer(text):
        if any(start <= m.start() < end for start, end in inline_spans):
            continue
        ref = m.group(2) if m.group(2) else m.group(1)
        target = definitions.get(" ".join(ref.split()).lower())
        if target is not None:
            found.append((m.start(), target))
    for m in IMG_TAG.finditer(text):
        found.append((m.start(), next(g for g in m.groups() if g is not None)))
    links = [(text.count("\n", 0, offset) + 1, path.strip()) for offset, path in found]
    return sorted(links)


def page_links(text: str) -> list[tuple[int, str]]:
    """(line, target) of every link of a markdown text that is not an image, one entry per link."""
    text = strip_code(text)
    definitions = {
        m.group(1).strip().lower(): m.group(2) or m.group(3) for m in DEFINITION.finditer(text)
    }
    ## images are the other check's, an image inside a link text leaves the link standing
    text = INLINE.sub(lambda m: blank(m.group(0)), text)
    text = REFERENCE.sub(lambda m: blank(m.group(0)), text)
    text = DEFINITION.sub(lambda m: blank(m.group(0)), text)
    found: list[tuple[int, str]] = []
    for m in LINK.finditer(text):
        found.append((m.start(), m.group(1) if m.group(1) is not None else m.group(2)))
    text = LINK.sub(lambda m: blank(m.group(0)), text)
    for m in BRACKETS.finditer(text):
        label = m.group(2) if m.group(2) else m.group(1)
        target = definitions.get(" ".join(label.split()).lower())
        if target is not None and not label.startswith("^"):
            found.append((m.start(), target))
    for m in A_TAG.finditer(text):
        found.append((m.start(), next(g for g in m.groups() if g is not None)))
    links = [(text.count("\n", 0, offset) + 1, path.strip()) for offset, path in found]
    return sorted(links)


def slug(heading: str) -> str:
    """GitHub's anchor of a heading text, before a -1, -2 suffix for a repeat."""
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", heading)
    text = re.sub(r"<[^>]*>", "", text).replace("`", "").replace("*", "")
    return re.sub(r"[^\w\- ]", "", text.strip().lower()).replace(" ", "-")


def anchors(text: str) -> set[str]:
    """The anchors a markdown text offers: its headings and the id or name of HTML tags."""
    text = HTML_COMMENT.sub(lambda m: blank(m.group(0)), strip_fences(text))
    lines = text.split("\n")
    found: set[str] = set()
    seen: dict[str, int] = {}
    for i, line in enumerate(lines):
        match = HEADING.match(line)
        heading = match.group(1) if match else None
        previous = lines[i - 1] if i > 0 else ""
        if not match and SETEXT.match(line) and previous.strip() and not HEADING.match(previous):
            heading = previous.strip()
        if not heading:
            continue
        base = slug(heading)
        count = seen.get(base, 0)
        seen[base] = count + 1
        found.add(base if count == 0 else f"{base}-{count}")
    for m in HTML_ID.finditer(text):
        found.add(m.group(1) if m.group(1) is not None else m.group(2))
    return found


def style_problems(text: str) -> list[tuple[int, str]]:
    """(line, style) of every semicolon, em dash and ` -- ` in the prose of a markdown text."""
    text = strip_code(strip_fences(text))
    text = HTML_COMMENT.sub(lambda m: blank(m.group(0)), text)
    spans: list[tuple[int, int]] = []
    for m in LINK.finditer(text):
        spans.append(m.span(1) if m.group(1) is not None else m.span(2))
    for m in DEFINITION.finditer(text):
        spans.append(m.span(2) if m.group(2) is not None else m.span(3))
    chars = list(text)
    for start, end in spans:
        for i in range(start, end):
            if chars[i] != "\n":
                chars[i] = " "
    text = "".join(chars)
    for pattern in (HTML_TAG, HTML_ENTITY, BARE_URL):
        text = pattern.sub(lambda m: blank(m.group(0)), text)
    found: list[tuple[int, str]] = []
    for number, line in enumerate(text.split("\n"), 1):
        if ";" in line:
            found.append((number, "semicolon"))
        if "\u2014" in line:
            found.append((number, "em dash"))
        if " -- " in line:
            found.append((number, "double hyphen as a dash"))
    return found


def local(path: str) -> str | None:
    """The file part of a link, None when the link is no local file."""
    if not path or path.startswith("#") or SCHEME.match(path):
        return None
    return re.split(r"[#?]", path, maxsplit=1)[0] or None


def candidates(root: Path, md: Path, path: str) -> list[Path]:
    base = root if path.startswith("/") else md.parent
    names = [path, unquote(path)]
    return [Path(os.path.normpath(base / name.lstrip("/"))) for name in names]


def tracked(root: Path, *patterns: str) -> list[Path]:
    out = subprocess.run(
        ["git", "ls-files", "-co", "--exclude-standard", "-z", "--", *patterns],
        cwd=root,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    ## a file git still lists but that is gone from the disk is no file
    paths = (root / name for name in out.split("\0") if name)
    return sorted(p for p in paths if p.is_file())


def lint(root: Path) -> list[str]:
    """The problems of the repo at root, one line each."""
    problems: list[str] = []
    linked: set[Path] = set()
    cache: dict[Path, set[str]] = {}

    def anchors_of(path: Path) -> set[str]:
        if path not in cache:
            text = path.read_text(encoding="utf-8", errors="replace")
            cache[path] = anchors(text)
        return cache[path]

    for md in tracked(root, "*.md"):
        text = md.read_text(encoding="utf-8", errors="replace")
        rel = md.relative_to(root)
        found: list[tuple[int, str]] = []
        for line, link in image_links(text):
            path = local(link)
            if path is None:
                continue
            options = candidates(root, md, path)
            linked.update(options)
            if not any(p.is_file() for p in options):
                found.append((line, f"missing image {link}"))
        for line, link in page_links(text):
            if SCHEME.match(link):
                continue
            path = local(link)
            fragment = link.partition("#")[2] if "#" in link else None
            if path is None:
                target, shown = md, str(rel)
            else:
                options = [p for p in candidates(root, md, path) if p.is_file()]
                if not options:
                    found.append((line, f"missing link {link}"))
                    continue
                target, shown = options[0], path
            if fragment and target.suffix.lower() == ".md":
                anchor = unquote(fragment)
                if anchor not in anchors_of(target):
                    found.append((line, f"no heading for #{anchor} in {shown}"))
        for line, style in style_problems(text):
            found.append((line, f"{style} ({STYLE_HINT})"))
        problems.extend(f"{rel}:{line}: {message}" for line, message in sorted(found))
    for image in tracked(root, f"{IMAGES}/"):
        if image.name.startswith("."):
            continue
        if Path(os.path.normpath(image)) not in linked:
            problems.append(f"{image.relative_to(root)}: not linked from any markdown file")
    return problems


def main(args: list[str]) -> int:
    if args:
        print("usage: docs-lint", file=sys.stderr)
        return 2
    problems = lint(ROOT)
    for problem in problems:
        print(problem)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
