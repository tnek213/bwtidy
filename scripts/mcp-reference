#!/usr/bin/env python3
"""mcp-reference: docs/reference/mcp-tools.md, written from the tools the MCP server registers.

  scripts/mcp-reference           write docs/reference/mcp-tools.md
  scripts/mcp-reference --check   write nothing, exit 1 when the file differs from what it writes

It builds the server with create_mcp_server and reads its list_tools, the same tool objects an MCP
client lists, so a new tool or a changed description reaches the page on the next run. Per tool:
its name, its kind (read, propose or end, from its annotations), its parameters with their types,
defaults and descriptions, and its description. A description is paragraphs and lists split by
blank lines, a list's lines each starting with "- ", and its `code` spans stay code. The page
wraps its text outside the tables at 80 characters (WIDTH, the line length of
.markdownlint-cli2.jsonc), never inside a code span, so the markdownlint check of scripts/ci passes
it as written. It imports bwtidy, so it runs with the backend venv's python and starts itself
through `uv run --locked` when it is not. `scripts/ci` runs the check.
"""

import asyncio
import json
import re
import sys
from typing import Any

from devlib import venv
from devlib.paths import ROOT

OUTPUT = ROOT / "docs" / "reference" / "mcp-tools.md"

INTRO = """\
# MCP tools

<!-- Written by scripts/mcp-reference from the tools the MCP server registers.
Do not edit it by hand. Run the script instead. -->

This page lists every tool that bwtidy's MCP server offers an AI agent. It shows
each tool's name, parameters and description as an MCP client sees them. The
agent reads your vault without the secret values and proposes changes to the
queue. It never changes the vault on its own. Nothing it proposes reaches the
vault until you approve it on the Queue page, where you can also reject it.

[What an agent can do](../explanation/mcp.md) explains why it works this way.
[Connect an MCP client](../how-to/mcp.md) shows how to connect your client.

Each tool is one of three kinds:

- A read tool reads the vault or the queue and changes nothing.
- A propose tool adds one entry to the queue. It changes nothing in the vault
  until you approve the entry.
- An end tool ends the bwtidy session like Log out in the web UI. It first
  writes the edits you have waiting in the web UI.

A tool's kind follows its MCP annotations, which the client sees too. A read
tool is marked read-only and an end tool is marked destructive.

The descriptions are the text the agent reads, so they speak to the agent. While
MCP is off a tool call answers only that bwtidy MCP is disabled. [When a request
fails](../how-to/mcp.md#when-a-request-fails) lists the checks that come first
and the answers they give.
"""

## the line under each tool's heading that names its kind
KIND_LINE = {"read": "A read tool.", "propose": "A propose tool.", "end": "An end tool."}

SECTIONS = {
    "read": "Read tools",
    "propose": "Propose tools",
    "end": "Tools that end the session",
}

## a markdown character escaped with a backslash wherever it shows in a description
ESCAPED = re.compile(r"([\\`*\[\]|#~])")
## an underscore that could start or end emphasis, one not between two letters or digits
LOOSE_UNDERSCORE = re.compile(r"(?<![0-9A-Za-z])_|_(?![0-9A-Za-z])")
## a code span, which markdown shows as it is, so nothing in it is escaped
CODE = re.compile(r"(`[^`]+`)")
BULLET = "- "
## the longest line of the page outside its tables, as .markdownlint-cli2.jsonc sets it (MD013)
WIDTH = 80
## a word that would start a list item or a heading underline at the start of a line
BLOCK_START = re.compile(r"[-+]|\d+[.)]|=+")


def registered_tools() -> list[Any]:
    """The tools the server lists, in their order, from a server with nothing behind it."""
    from bwtidy.mcp.server import create_mcp_server

    ## registering a tool only keeps the four, no tool runs here
    nothing: Any = None
    server = create_mcp_server(nothing, nothing, nothing, nothing)
    return asyncio.run(server.list_tools())


def kind(tool: Any) -> str:
    """read, propose or end: the kind whose annotations the tool was registered with."""
    from bwtidy.mcp.server import END, PROPOSE, READ_ONLY

    for name, annotations in (("read", READ_ONLY), ("propose", PROPOSE), ("end", END)):
        if tool.annotations == annotations:
            return name
    raise ValueError(f"{tool.name}: its annotations are none of READ_ONLY, PROPOSE and END")


def plain(value: str) -> str:
    """Text without code spans as markdown that shows it as it is."""
    value = value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    value = ESCAPED.sub(r"\\\1", value)
    return LOOSE_UNDERSCORE.sub(r"\\_", value)


def text(value: str) -> str:
    """Text as markdown on one line that shows it as it is, its code spans as code."""
    parts = CODE.split(" ".join(value.split()))
    ## split with a group puts each code span at an odd index
    return "".join(part if index % 2 else plain(part) for index, part in enumerate(parts))


def words(line: str) -> list[str]:
    """The words of a line of markdown, split at the spaces outside its code spans."""
    inside = {index for span in CODE.finditer(line) for index in range(*span.span())}
    found, start = [], 0
    for index, char in enumerate(line):
        if char == " " and index not in inside:
            found.append(line[start:index])
            start = index + 1
    return [*found, line[start:]]


def wrapped(line: str, first: str = "", rest: str = "") -> list[str]:
    """A line of markdown as lines of at most WIDTH characters, FIRST and REST before them.

    A code span is never broken and a word longer than the rest of a line gets a line of its own.
    A word that would start a block at the start of a line stays at the end of the line before.
    """
    lines: list[str] = []
    current = ""
    for word in words(line):
        if not current:
            current = (rest if lines else first) + word
        elif len(current) + 1 + len(word) <= WIDTH or BLOCK_START.fullmatch(word):
            current += " " + word
        else:
            lines.append(current)
            current = rest + word
    return [*lines, current]


def description(value: str) -> list[str]:
    """A tool's description as markdown: its paragraphs and lists, a blank line after each."""
    lines = []
    for block in value.strip().split("\n\n"):
        entries = block.split("\n")
        if all(entry.startswith(BULLET) for entry in entries):
            for entry in entries:
                lines += wrapped(text(entry.removeprefix(BULLET)), BULLET, " " * len(BULLET))
        else:
            lines += wrapped(text(block))
        lines.append("")
    return lines


def or_list(parts: list[str]) -> str:
    return parts[0] if len(parts) == 1 else f"{', '.join(parts[:-1])} or {parts[-1]}"


def type_parts(schema: dict[str, Any], defs: dict[str, Any]) -> list[str]:
    """The alternatives of a JSON schema type, each in a few words: `string`, `list of string`."""
    if "$ref" in schema:
        name = schema["$ref"].rsplit("/", 1)[-1]
        target = defs[name]
        return [f"`{name}`"] if "properties" in target else type_parts(target, defs)
    if "anyOf" in schema:
        return [part for choice in schema["anyOf"] for part in type_parts(choice, defs)]
    if "enum" in schema:
        return [f"`{json.dumps(value)}`" for value in schema["enum"]]
    match schema.get("type"):
        case "array":
            return [f"list of {inner_text(schema.get('items', {}), defs)}"]
        case "object" if isinstance(schema.get("additionalProperties"), dict):
            return [f"object of {inner_text(schema['additionalProperties'], defs)}"]
        case str(name):
            return [name]
    return ["any"]


def type_text(schema: dict[str, Any], defs: dict[str, Any]) -> str:
    return or_list(type_parts(schema, defs))


def inner_text(schema: dict[str, Any], defs: dict[str, Any]) -> str:
    """The type of a list's or an object's values, in parentheses when it has alternatives."""
    parts = type_parts(schema, defs)
    return or_list(parts) if len(parts) == 1 else f"({or_list(parts)})"


def parameter_rows(schema: dict[str, Any], defs: dict[str, Any]) -> list[str]:
    required = set(schema.get("required", []))
    rows = []
    for name, field in schema.get("properties", {}).items():
        default = "required" if name in required else f"`{json.dumps(field.get('default'))}`"
        description = text(field.get("description", ""))
        rows.append(f"| `{name}` | {type_text(field, defs)} | {default} | {description} |")
    return rows


def table(schema: dict[str, Any], defs: dict[str, Any]) -> list[str]:
    return [
        "| Parameter | Type | Default | Description |",
        "| --- | --- | --- | --- |",
        *parameter_rows(schema, defs),
    ]


def tool_section(tool: Any) -> list[str]:
    schema = tool.input_schema
    defs = schema.get("$defs", {})
    lines = [
        f"### {tool.name}",
        "",
        KIND_LINE[kind(tool)],
        "",
        *description(tool.description or ""),
    ]
    if not schema.get("properties"):
        return [*lines, "No parameters.", ""]
    lines += ["Parameters:", "", *table(schema, defs), ""]
    for name, target in defs.items():
        if "properties" in target:
            lines += [f"Each `{name}`:", "", *table(target, defs), ""]
    return lines


def rendered(tools: list[Any]) -> str:
    lines = [INTRO]
    for kind_name, heading in SECTIONS.items():
        lines += [f"## {heading}", ""]
        for tool in tools:
            if kind(tool) == kind_name:
                lines += tool_section(tool)
    return "\n".join(lines).rstrip("\n") + "\n"


def main(args: list[str]) -> int:
    if args not in ([], ["--check"]):
        print("usage: mcp-reference [--check]", file=sys.stderr)
        return 2
    venv.run_in_backend_venv("mcp-reference", __file__, args)
    tools = registered_tools()
    page = rendered(tools)
    shown = OUTPUT.relative_to(ROOT)
    if args == ["--check"]:
        if not OUTPUT.exists() or OUTPUT.read_text() != page:
            print(f"mcp-reference: {shown} is stale, run scripts/mcp-reference", file=sys.stderr)
            return 1
        return 0
    OUTPUT.write_text(page)
    print(f"mcp-reference: wrote {len(tools)} tools to {shown}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
