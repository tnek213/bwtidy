#!/usr/bin/env python3
"""prune-tags: delete the old short-commit tags of docker.io/tnek213/bwtidy on Docker Hub.

  scripts/prune-tags            dry run: print what it keeps and why, and what it would delete
  scripts/prune-tags --delete   delete those tags

Every push to main publishes the image as `main` and as its short commit (7 lowercase hex
characters), so those tags pile up. It lists every tag of the repository through Docker Hub's
API, page by page, and keeps:

- every tag that is not exactly 7 lowercase hex characters (the versions, latest, main and any
  other name),
- the 10 newest short-commit tags by last push,
- the short commit of every commit a git tag v* points to (git tag -l 'v*', git rev-list -n 1),
  as a server may run a release by its commit,
- every short-commit tag with the same digest as main or latest.

It deletes the rest. The token comes from the environment variable DOCKERHUB_PAT, a Docker Hub
personal access token of tnek213 with Read, Write, Delete. A dry run works without one (the
repository is public) and logs in when one is set. It never prints the token. It stops with an
error, deleting nothing, when the listing fails or finds no tags, or when Docker Hub has a
version tag but the checkout has no git tag v* (a checkout without its tags). A failed delete
is reported and the others go on, then it exits 1.
"""

import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path

from devlib.paths import ROOT

HUB = "https://hub.docker.com"
USERNAME = "tnek213"
NAMESPACE = "tnek213"
REPOSITORY = "bwtidy"
TOKEN_ENV = "DOCKERHUB_PAT"
KEEP_NEWEST = 10
PAGE_SIZE = 100
TIMEOUT = 60
SHORT = re.compile(r"[0-9a-f]{7}")
## the regex of the repository's immutable tags on Docker Hub
VERSION = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+(-.+)?")
## a tag never pushed sorts as the oldest
NEVER = datetime.min.replace(tzinfo=UTC)


class PruneError(Exception):
    """Why prune-tags stops. Its text never holds the token."""


@dataclass(frozen=True)
class Tag:
    name: str
    digest: str | None
    pushed: datetime


@dataclass(frozen=True)
class Decision:
    tag: Tag
    reasons: tuple[str, ...]

    @property
    def keep(self) -> bool:
        return bool(self.reasons)


def parse_time(text: str | None) -> datetime:
    return datetime.fromisoformat(text) if text else NEVER


class Hub:
    """Docker Hub's API for the repository, with a bearer token once logged in."""

    def __init__(self) -> None:
        self.token: str | None = None

    def _send(self, method: str, url: str, body: dict[str, str] | None = None) -> bytes:
        headers = {"Accept": "application/json"}
        data = None
        if body is not None:
            headers["Content-Type"] = "application/json"
            data = json.dumps(body).encode()
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        request = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT) as answer:
                return answer.read()
        except urllib.error.HTTPError as error:
            raise PruneError(f"{method} {url} failed: HTTP {error.code} {error.reason}") from None
        except (urllib.error.URLError, TimeoutError) as error:
            raise PruneError(f"{method} {url} failed: {error}") from None

    def login(self, secret: str) -> None:
        ## /v2/auth/token is the login Docker Hub documents, /v2/users/login is deprecated
        answer = self._send(
            "POST", f"{HUB}/v2/auth/token", {"identifier": USERNAME, "secret": secret}
        )
        try:
            token = json.loads(answer)["access_token"]
        except (ValueError, KeyError, TypeError):
            raise PruneError("the login at Docker Hub returned no access token") from None
        if not isinstance(token, str) or not token:
            raise PruneError("the login at Docker Hub returned no access token")
        self.token = token

    def tags(self) -> list[Tag]:
        found: list[Tag] = []
        url: str | None = (
            f"{HUB}/v2/namespaces/{NAMESPACE}/repositories/{REPOSITORY}/tags?page_size={PAGE_SIZE}"
        )
        while url:
            ## the next page carries the bearer token, so it must stay on Docker Hub
            if not url.startswith(f"{HUB}/"):
                raise PruneError(f"the listing points to a page outside Docker Hub: {url}")
            try:
                page = json.loads(self._send("GET", url))
                results = page["results"]
                url = page.get("next")
                found += [
                    Tag(item["name"], item.get("digest"), parse_time(item.get("tag_last_pushed")))
                    for item in results
                ]
            except (ValueError, KeyError, TypeError) as error:
                raise PruneError(f"the tag listing has an unexpected shape: {error!r}") from None
        return found

    def delete(self, name: str) -> None:
        ## Docker Hub's API reference no longer lists a tag delete, this route is the one that works
        self._send("DELETE", f"{HUB}/v2/repositories/{NAMESPACE}/{REPOSITORY}/tags/{name}/")


def git_output(*args: str, repo: Path) -> str:
    result = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)
    if result.returncode != 0:
        raise PruneError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def release_commits(repo: Path = ROOT) -> dict[str, str]:
    """The short commit of every git tag v*, mapped to the tag."""
    releases: dict[str, str] = {}
    for tag in git_output("tag", "-l", "v*", repo=repo).split():
        commit = git_output("rev-list", "-n", "1", tag, repo=repo)
        releases.setdefault(commit[:7], tag)
    return releases


def plan(tags: list[Tag], releases: dict[str, str]) -> list[Decision]:
    """What happens to each tag, newest push first: kept with its reasons, or deleted."""
    by_name = {tag.name: tag for tag in tags}
    shared = {
        name: by_name[name].digest
        for name in ("main", "latest")
        if name in by_name and by_name[name].digest
    }
    ordered = sorted(tags, key=lambda tag: tag.pushed, reverse=True)
    shorts = [tag for tag in ordered if SHORT.fullmatch(tag.name)]
    newest = {tag.name for tag in shorts[:KEEP_NEWEST]}
    decisions: list[Decision] = []
    for tag in ordered:
        reasons: list[str] = []
        if not SHORT.fullmatch(tag.name):
            reasons.append("not a short commit")
        else:
            if tag.name in releases:
                reasons.append(f"the commit of {releases[tag.name]}")
            reasons += [
                f"the same image as {name}"
                for name, digest in shared.items()
                if tag.digest == digest
            ]
            if tag.name in newest:
                reasons.append(f"one of the {KEEP_NEWEST} newest short commits")
        decisions.append(Decision(tag, tuple(reasons)))
    return decisions


def pushed_text(tag: Tag) -> str:
    return "never pushed" if tag.pushed == NEVER else f"pushed {tag.pushed:%Y-%m-%d %H:%M} UTC"


def prune(hub: Hub, secret: str | None, delete: bool, releases: dict[str, str]) -> int:
    if secret:
        hub.login(secret)
    elif delete:
        raise PruneError(f"--delete needs the environment variable {TOKEN_ENV}")
    tags = hub.tags()
    if not tags:
        raise PruneError("Docker Hub listed no tags, so nothing is deleted")
    if not releases and any(VERSION.fullmatch(tag.name) for tag in tags):
        raise PruneError(
            "Docker Hub has version tags but the checkout has no git tag v*, fetch the tags first"
        )
    decisions = plan(tags, releases)
    doomed = [d.tag for d in decisions if not d.keep]
    for decision in decisions:
        if decision.keep:
            print(f"keep {decision.tag.name}: {', '.join(decision.reasons)}")
    verb = "delete" if delete else "would delete"
    for tag in doomed:
        print(f"{verb} {tag.name}: an older short commit, {pushed_text(tag)}")
    gone = "to delete" if delete else "would be deleted"
    print(f"{len(decisions)} tags: {len(decisions) - len(doomed)} kept, {len(doomed)} {gone}")
    if not delete:
        return 0
    failed = 0
    for tag in doomed:
        try:
            hub.delete(tag.name)
        except PruneError as error:
            failed += 1
            print(f"prune-tags: {error}", file=sys.stderr)
        else:
            print(f"deleted {tag.name}")
    return 1 if failed else 0


def main(args: list[str]) -> int:
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if args not in ([], ["--delete"]):
        print(__doc__, file=sys.stderr)
        return 2
    try:
        return prune(Hub(), os.environ.get(TOKEN_ENV), args == ["--delete"], release_commits())
    except PruneError as error:
        print(f"prune-tags: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
