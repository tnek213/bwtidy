#!/usr/bin/env python3
"""docs-site: the documentation site that the gateway serves at /docs/, built with Zensical.

  scripts/docs-site build [DIR]   build the site strictly into DIR (default a temp directory,
                                  deleted after), fail on any warning. DIR is replaced only
                                  after the build passed, and only when it is missing, empty
                                  or a previous build (it holds index.html and sitemap.xml),
                                  else the command refuses
  scripts/docs-site serve [ARGS]  preview it with `zensical serve`, rebuilt on every change
                                  (ARGS go to zensical, such as --dev-addr localhost:8001)

The site is zensical.toml at the repo root over the pages in docs/, with the theme overrides in
overrides/ (its main.html puts the alpha disclaimer as a banner above every page, widens the
content column, opens a picture larger on a click and links every page to the issue form for
docs improvements, with the version below). Zensical comes
from the backend's dependency group `docs` (backend/pyproject.toml, pinned in backend/uv.lock), run
through `uv run --locked --only-group docs`, so neither bwtidy nor its dependencies are needed. The
Dockerfile's docs stage and the Pages workflow (.github/workflows/docs.yml) run `build` too.

`build` fails on a broken nav entry or a link to a page or anchor that is not in the site, so a
link out of docs/ (like one to dev/README.md) fails as well. It also fails, before Zensical runs,
on a page of docs/ that the nav leaves out, as Zensical builds it without a way to reach it, and,
after Zensical, on a built HTML page without the banner's marker (the attribute data-disclaimer),
naming each such page, and on a numbered list that starts at 1 again right after another one with
only a picture or code block between them (a step's continuation not indented enough), naming the
page and the line of its HTML, and on a page that has the browser fetch anything from another host
(a script, stylesheet, icon, picture, frame or CSS url() with a host of its own: a running bwtidy
serves the site offline), naming the page, the line and the URL. A link to another host is fine.
Zensical writes its output and its cache inside the project, so
`build` copies zensical.toml, docs/ and overrides/ into a temp directory and builds there: nothing
in the checkout changes and two builds never meet. `serve` runs in the checkout and leaves site/ and
.cache/ there, both git-ignored.

Every backup holds docs/restore.md as RESTORE.md, with the version of the image in place of
COMMIT on its line "Written for bwtidy COMMIT." (RESTORE_DOC_COMMIT in backups/collect.py).
`build` does the same in its copy, with the version the site is built for: the one of
backend/pyproject.toml spelled the semver way, then the commit, from BWTIDY_COMMIT (the
Dockerfile passes it) or else the checkout's last commit, as `0.1.0-alpha.1 (261111 7db8830)`.
It fails when the page lacks the line. `serve` shows the page as it is.
"""

import importlib.util
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from collections.abc import Iterator
from html.parser import HTMLParser
from pathlib import Path
from typing import Any
from urllib.parse import urlsplit

## the Dockerfile's docs stage copies this script alone, so it stays free of scripts/devlib
ROOT = Path(__file__).resolve().parent.parent
BACKEND = ROOT / "backend"
CONFIG = "zensical.toml"
SERVE_CONFIG = ".zensical-serve.toml"
DOCS = "docs"
OVERRIDES = "overrides"
BANNER_MARKER = "data-disclaimer"
## the line of the restore page that the version goes into, the same as RESTORE_DOC_COMMIT in
## backend/src/bwtidy/backups/collect.py (a test checks they agree)
RESTORE_PAGE = "restore.md"
RESTORE_DOC_COMMIT = "Written for bwtidy COMMIT."
## what Zensical writes at the top of every site, so a directory that holds both is a build
BUILD_MARKERS = ("index.html", "sitemap.xml")
ZENSICAL = [
    "uv",
    "run",
    "--quiet",
    "--locked",
    "--project",
    str(BACKEND),
    "--only-group",
    "docs",
    "zensical",
]
## the rel values of a link tag that only points somewhere, so the browser never fetches its href
LINK_ONLY = {"alternate", "author", "canonical", "help", "license", "next", "prev", "search"}
## a URL in CSS, of url(...) or @import, whether quoted or not
CSS_URL = re.compile(r"""(?:url\(|@import)\s*['"]?\s*([^'")\s]+)""", re.IGNORECASE)
VOID_TAGS = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source"}


class Node:
    """An element of a built page: its tag, attributes, line, children and what it holds."""

    def __init__(self, tag: str, attrs: dict[str, str | None], line: int) -> None:
        self.tag = tag
        self.attrs = attrs
        self.line = line
        self.children: list[Node] = []
        self.has_text = False
        self.has_image = False

    @property
    def classes(self) -> list[str]:
        return (self.attrs.get("class") or "").split()

    def is_picture_or_code(self) -> bool:
        """A block that holds a picture or a code block and nothing else."""
        if self.tag == "pre" or "highlight" in self.classes:
            return True
        if self.tag in ("p", "figure"):
            return self.has_image and not self.has_text
        return False


class Tree(HTMLParser):
    """The elements of an HTML page as a tree, void tags without children."""

    def __init__(self) -> None:
        super().__init__()
        self.root = Node("#root", {}, 0)
        self.stack = [self.root]

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        node = Node(tag, dict(attrs), self.getpos()[0])
        self.stack[-1].children.append(node)
        if tag == "img":
            for open_node in self.stack:
                open_node.has_image = True
        if tag not in VOID_TAGS:
            self.stack.append(node)

    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        self.handle_starttag(tag, attrs)
        if tag not in VOID_TAGS:
            self.stack.pop()

    def handle_endtag(self, tag: str) -> None:
        for index in range(len(self.stack) - 1, 0, -1):
            if self.stack[index].tag == tag:
                del self.stack[index:]
                return

    def handle_data(self, data: str) -> None:
        if data.strip():
            for node in self.stack:
                node.has_text = True


def split_lists(node: Node) -> Iterator[int]:
    """The lines of the ordered lists in node that restart at 1 right after an ordered list.

    Only a picture or a code block may lie between the two, which is what a continuation that
    the Markdown did not indent far enough turns into."""
    previous = False
    for child in node.children:
        if child.tag == "ol":
            if previous and "start" not in child.attrs:
                yield child.line
            previous = True
        elif not child.is_picture_or_code():
            previous = False
        yield from split_lists(child)


def broken_lists(site: Path) -> list[str]:
    """One message per page and line of the built site where a numbered list is split."""
    found = []
    for page in sorted(site.rglob("*.html")):
        tree = Tree()
        tree.feed(page.read_text(encoding="utf-8"))
        name = page.relative_to(site).as_posix()
        found.extend(
            f"{name}:{line}: an ordered list starts at 1 again after a picture or code block"
            for line in split_lists(tree.root)
        )
    return found


class Loads(HTMLParser):
    """What an HTML page has the browser fetch: each URL with its line."""

    def __init__(self) -> None:
        super().__init__()
        self.found: list[tuple[int, str]] = []
        self.in_style = False

    def note(self, url: str) -> None:
        self.found.append((self.getpos()[0], url.strip()))

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        values = {name: value or "" for name, value in attrs}
        for name in ("src", "poster"):
            if values.get(name):
                self.note(values[name])
        if tag == "object" and values.get("data"):
            self.note(values["data"])
        for candidate in values.get("srcset", "").split(","):
            if candidate.strip():
                self.note(candidate.split()[0])
        if tag == "link" and values.get("href"):
            rel = set(values.get("rel", "").lower().split())
            if not rel or not rel <= LINK_ONLY:
                self.note(values["href"])
        for url in CSS_URL.findall(values.get("style", "")):
            self.note(url)
        self.in_style = tag == "style"

    def handle_endtag(self, tag: str) -> None:
        if tag == "style":
            self.in_style = False

    def handle_data(self, data: str) -> None:
        if self.in_style:
            for url in CSS_URL.findall(data):
                self.note(url)


def external_loads(site: Path) -> list[str]:
    """One message per page, line and URL of the built site that is fetched from another host."""
    found = []
    for page in sorted(site.rglob("*.html")):
        loads = Loads()
        loads.feed(page.read_text(encoding="utf-8"))
        name = page.relative_to(site).as_posix()
        found.extend(
            f"{name}:{line}: loads {url} from another host"
            for line, url in loads.found
            if urlsplit(url).netloc
        )
    return found


def nav_pages(entries: Any) -> Iterator[str]:
    """Every page path of a nav: a list of paths and of {title: path or list} tables."""
    if isinstance(entries, str):
        yield entries
    elif isinstance(entries, list):
        for entry in entries:
            yield from nav_pages(entry)
    elif isinstance(entries, dict):
        for value in entries.values():
            yield from nav_pages(value)


def left_out() -> list[str]:
    """The pages of docs/ that the nav of zensical.toml does not list."""
    with (ROOT / CONFIG).open("rb") as file:
        nav = set(nav_pages(tomllib.load(file)["project"]["nav"]))
    pages = (path.relative_to(ROOT / DOCS).as_posix() for path in (ROOT / DOCS).rglob("*.md"))
    return sorted(page for page in pages if page not in nav)


def last_commit() -> str | None:
    """The checkout's last commit as the image workflow names it, None outside a git checkout."""
    try:
        result = subprocess.run(
            ["git", "log", "-1", "--format=%cd %h", "--date=format:%y%m%d"],
            cwd=ROOT,
            capture_output=True,
            text=True,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def site_version() -> str:
    """The version the site is built for, as /api/health spells it."""
    with (ROOT / "backend" / "pyproject.toml").open("rb") as file:
        version = tomllib.load(file)["project"]["version"]
    ## stdlib only, so it loads by path without bwtidy's dependencies
    path = ROOT / "backend" / "src" / "bwtidy" / "version.py"
    spec = importlib.util.spec_from_file_location("bwtidy_version", path)
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    semver = module.semver(version)
    commit = os.environ.get("BWTIDY_COMMIT", "").strip() or last_commit()
    return f"{semver} ({commit})" if commit else semver


def with_version(config: str, version: str) -> str:
    """The config text with the version as extra.bwtidy_version, for the link on every page."""
    return f'{config.rstrip()}\n\n[project.extra]\nbwtidy_version = "{version}"\n'


def fill_in_version(docs: Path, version: str) -> bool:
    """Put the version into the copy of the restore page, False when it lacks the line."""
    page = docs / RESTORE_PAGE
    text = page.read_text(encoding="utf-8")
    if RESTORE_DOC_COMMIT not in text:
        return False
    filled = text.replace(RESTORE_DOC_COMMIT, f"Written for bwtidy {version}.", 1)
    page.write_text(filled, encoding="utf-8")
    return True


def without_banner(site: Path) -> list[str]:
    """The HTML pages of a built site that lack the disclaimer banner's marker."""
    pages = sorted(site.rglob("*.html"))
    return [
        page.relative_to(site).as_posix()
        for page in pages
        if BANNER_MARKER not in page.read_text(encoding="utf-8")
    ]


def refusal(target: Path) -> str | None:
    """Why build must not replace the target: it is neither missing, empty nor a build."""
    if not target.exists():
        return None
    if not target.is_dir():
        return f"{target} is not a directory"
    if not any(target.iterdir()) or all((target / name).is_file() for name in BUILD_MARKERS):
        return None
    return f"{target} is not empty and not a previous build (it lacks {' or '.join(BUILD_MARKERS)})"


def replace(target: Path, site: Path) -> None:
    """Put a copy of the built site at target, the old one stays until the copy is in place."""
    target.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=f".{target.name}-", dir=target.parent))
    old = target.with_name(f".old-{target.name}")
    try:
        shutil.copytree(site, staging / "site")
        if old.exists():
            shutil.rmtree(old)
        moved = target.exists()
        if moved:
            os.replace(target, old)
        try:
            os.replace(staging / "site", target)
        except BaseException:
            if moved:
                os.replace(old, target)
            raise
        shutil.rmtree(old, ignore_errors=True)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def build(target: Path | None) -> int:
    if target is not None and (why := refusal(target)):
        print(f"docs-site: {why}, nothing was built", file=sys.stderr)
        return 1
    missing = left_out()
    for page in missing:
        print(f"docs-site: docs/{page} is not in the nav of {CONFIG}", file=sys.stderr)
    if missing:
        return 1
    with tempfile.TemporaryDirectory(prefix="bwtidy-docs-site-") as temp:
        project = Path(temp)
        version = site_version()
        config = ROOT.joinpath(CONFIG).read_text(encoding="utf-8")
        (project / CONFIG).write_text(with_version(config, version), encoding="utf-8")
        shutil.copytree(ROOT / DOCS, project / DOCS)
        shutil.copytree(ROOT / OVERRIDES, project / OVERRIDES)
        if not fill_in_version(project / DOCS, version):
            print(
                f"docs-site: docs/{RESTORE_PAGE} has no line {RESTORE_DOC_COMMIT!r}",
                file=sys.stderr,
            )
            return 1
        built = subprocess.run([*ZENSICAL, "build", "--strict"], cwd=project)
        if built.returncode != 0:
            return 1
        bare = without_banner(project / "site")
        for page in bare:
            print(f"docs-site: {page} has no disclaimer banner ({BANNER_MARKER})", file=sys.stderr)
        if bare:
            return 1
        split = broken_lists(project / "site")
        for message in split:
            print(
                f"docs-site: {message}, indent what lies between its steps by 4 spaces",
                file=sys.stderr,
            )
        if split:
            return 1
        external = external_loads(project / "site")
        for message in external:
            print(
                f"docs-site: {message}, a running bwtidy serves the site offline", file=sys.stderr
            )
        if external:
            return 1
        if target is not None:
            replace(target, project / "site")
            print(f"docs-site: built into {target}")
    return 0


def serve(args: list[str]) -> int:
    ## a config beside zensical.toml that adds the version, as docs_dir and custom_dir are
    ## relative to the config file
    config = ROOT / SERVE_CONFIG
    config.write_text(
        with_version(ROOT.joinpath(CONFIG).read_text(encoding="utf-8"), site_version()),
        encoding="utf-8",
    )
    try:
        return subprocess.run([*ZENSICAL, "serve", "-f", str(config), *args], cwd=ROOT).returncode
    finally:
        config.unlink(missing_ok=True)


def main(args: list[str]) -> int:
    if args[:1] == ["build"] and len(args) <= 2:
        return build(Path(args[1]).absolute() if len(args) == 2 else None)
    if args[:1] == ["serve"]:
        return serve(args[1:])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
