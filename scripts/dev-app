#!/usr/bin/env python3
"""dev-app: run bwtidy against this worktree's dev vault and open it in the browser.

  scripts/dev-app [--no-open]

Runs scripts/dev-vault up every time, which rebuilds the image so a git pull needs
nothing else, and setup when the stack was not up. Then starts the gateway as root in the
app container, which serves the built frontend and starts one worker per account. Opens the
page with xdg-open once the gateway answers. Its output also goes to .dev-vault/backend.log
(appended), each worker's goes to worker.log in its account directory. Ctrl+C stops the
gateway and its workers, the stack keeps running until scripts/dev-vault down.

The backend runs from the mounted backend/, the frontend is the one built into the
image. Dev credentials only, see dev/README.md.
"""

import os
import sys

from devlib import gateway
from devlib.paths import ROOT

## the stack of the worktree that has .dev-vault.env
STACK = 1


def main(args: list[str]) -> int:
    if args not in ([], ["--no-open"]):
        print("usage: dev-app [--no-open]", file=sys.stderr)
        return 2
    return gateway.run_backend(STACK, open_browser=not args)


if __name__ == "__main__":
    os.chdir(ROOT)
    sys.exit(main(sys.argv[1:]))
