#!/usr/bin/env python3
"""update-deps: update every dependency within its declared range, never past it.

  scripts/update-deps                         update the lock files, the image digests and the
                                              action SHAs
  scripts/update-deps --dry-run               show what would change and write nothing
  scripts/update-deps --cli-pin [--root DIR] [--pr N]
                                              only write the pin of the Bitwarden CLI in DIR
                                              (the repo by default), with --dry-run to show it

--cli-pin writes every place that states the CLI version docker/bitwarden-cli/package.json pins:
source.json's tag cli-vVERSION and the commit it names, and the docs in CLI_PIN_DOCS. With --pr N,
the number of the pull request that bumps the CLI, it also writes the bullet "Run the Bitwarden
CLI VERSION in the image" with the link to pull request N under Unreleased in docs/releases.md,
in place of "Nothing yet." and only once. It reads only those data files below DIR and runs
nothing from it, so a workflow runs main's copy on the files of a pull request
(.github/workflows/dependabot-cli-pin.yml).

Backend and demo: uv lock --upgrade, within the ranges of backend/pyproject.toml and
demo/pyproject.toml. Frontend: npm update
within the ranges of frontend/package.json (an exact pin stays), then npm ci so node_modules
match. The image's Bitwarden CLI (docker/bitwarden-cli): npm update --package-lock-only, as only
the image installs it, and source.json gets the tag cli-vVERSION of the version package.json
pins and the commit that tag names, the source the image builds the CLI from, and the docs that
state the version get it (the same as --cli-pin). markdownlint-cli2
(tools/markdownlint) the same way as the CLI's lock file, as scripts/ci runs npm ci there once
its lock file changed. The Dockerfile, demo/Dockerfile and compose.demo.yaml (the
demo's Vaultwarden and nginx): each image keeps the tag it names and gets the digest that tag
points to now. The workflows: each action moves to the newest release tag of its major
version, with its commit SHA and that tag in the comment above it. Then it runs
scripts/third-party and the version check, and prints what changed (package, old version, new
version) per ecosystem. Last it lists the updates outside the ranges (new major versions, newer
image tags, newer action majors) without applying them, for a human to decide on. It never
commits and never changes bwtidy's own version.
"""

import json
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import urllib.error
import urllib.request
from dataclasses import dataclass
from pathlib import Path

from devlib import versions
from devlib.paths import ROOT, SCRIPTS

BACKEND = ROOT / "backend"
DEMO = ROOT / "demo"
FRONTEND = ROOT / "frontend"
CLI = ROOT / "docker" / "bitwarden-cli"
CLI_PACKAGE = "@bitwarden/cli"
CLI_REPOSITORY = "https://github.com/bitwarden/clients"
## the docs that state the CLI version the image pins, by their path in the repo, each with a
## pattern whose group "version" is that version. A line that tells what one version of bw did is
## an observation of that version and stays as it is.
CLI_PIN_DOCS = {
    "README.md": r"at the tag\s+`cli-v(?P<version>[^`\s]+)`",
    "docker/hub-overview.md": r"at the tag\s+`cli-v(?P<version>[^`\s]+)`",
    "docs/restore.md": r"npm install .*@bitwarden/cli@(?P<version>\S+)",
}
MARKDOWNLINT = ROOT / "tools" / "markdownlint"
DOCKERFILE = ROOT / "Dockerfile"
## every file that pins images by tag and digest: the two Dockerfiles and the demo's compose file
IMAGE_FILES = [DOCKERFILE, DEMO / "Dockerfile", ROOT / "compose.demo.yaml"]
WORKFLOWS = ROOT / ".github" / "workflows"
## seconds for one network command or request, a registry with many tags pages through several
TIMEOUT = 120
INDEX_TYPES = ", ".join(
    [
        "application/vnd.oci.image.index.v1+json",
        "application/vnd.docker.distribution.manifest.list.v2+json",
        "application/vnd.oci.image.manifest.v1+json",
        "application/vnd.docker.distribution.manifest.v2+json",
    ]
)

## a package that is new or gone has None on that side
Change = tuple[str, str | None, str | None]


@dataclass(frozen=True)
class ImageRef:
    """An image with a tag in a Dockerfile or compose file: its line, image, tag and digest."""

    line: int
    image: str
    tag: str
    digest: str | None


@dataclass(frozen=True)
class ActionPin:
    """An action of a workflow pinned to a commit SHA, with its tag in the comment above."""

    line: int
    action: str
    tag: str
    sha: str


## --- versions and tags


def numbers(tag: str) -> tuple[tuple[int, ...], str] | None:
    """The leading numbers of a tag and the rest: 24-trixie-slim is ((24,), "-trixie-slim")."""
    match = re.fullmatch(r"v?(\d+(?:\.\d+)*)(.*)", tag)
    if match is None:
        return None
    return tuple(int(n) for n in match[1].split(".")), match[2]


def newer_tags(tag: str, tags: list[str]) -> list[str]:
    """The tags of the same form as TAG (as many numbers, the same rest) with a higher version.

    That is what a human decides on: python 3.13-slim-trixie finds 3.14-slim-trixie, node 24
    finds 26, never a variant such as 3.14-alpine. Oldest first.
    """
    own = numbers(tag)
    if own is None:
        return []
    found = []
    for other in tags:
        parsed = numbers(other)
        if parsed and parsed[1] == own[1] and len(parsed[0]) == len(own[0]) and parsed[0] > own[0]:
            found.append((parsed[0], other))
    return [name for _, name in sorted(found)]


def release_version(tag: str) -> tuple[int, ...] | None:
    """The version of a release tag such as v7 or v10.3.3, None for any other tag."""
    parsed = numbers(tag)
    return parsed[0] if parsed and parsed[1] == "" else None


def newest_in_major(tag: str, tags: list[str]) -> str:
    """The newest release tag of TAG's major version, a full version before a bare v7."""
    own = release_version(tag)
    if own is None:
        return tag
    best = tag
    best_key = (*own, *([0] * (3 - len(own))), len(own))
    for other in tags:
        version = release_version(other)
        if version is None or version[0] != own[0]:
            continue
        key = (*version, *([0] * (3 - len(version))), len(version))
        if key > best_key:
            best, best_key = other, key
    return best


def newer_majors(tag: str, tags: list[str]) -> list[str]:
    """The release tags of a higher major version than TAG's, the newest of each, oldest first."""
    own = release_version(tag)
    if own is None:
        return []
    majors = sorted({v[0] for t in tags if (v := release_version(t)) and v[0] > own[0]})
    return [newest_in_major(f"v{major}", tags) for major in majors]


## --- the Dockerfiles and the compose file


def image_refs(text: str) -> list[ImageRef]:
    """Every image with a tag in a Dockerfile or a compose file.

    In a Dockerfile the syntax line and the FROM lines, in a compose file the image lines. A
    FROM of an earlier stage (FROM node AS frontend) names no tag and is left out, as is an
    image that comes from a variable (FROM ${BWTIDY_IMAGE}, image: ${DEMO_IMAGE:-name:tag}):
    that one is ours, or picked by whoever runs it.
    """
    refs = []
    for index, line in enumerate(text.splitlines()):
        match = re.match(r"(?:# syntax=|FROM\s+(?:--platform=\S+\s+)?|\s*image:\s+)(\S+)", line)
        if match is None or "$" in match[1]:
            continue
        name, _, digest = match[1].partition("@")
        image, colon, tag = name.rpartition(":")
        if not colon or "/" in tag:
            continue
        refs.append(ImageRef(index, image, tag, digest or None))
    return refs


def with_digest(text: str, ref: ImageRef, digest: str) -> str:
    """TEXT with the image of REF pinned to DIGEST, its tag as it was."""
    lines = text.split("\n")
    old = f"{ref.image}:{ref.tag}" + (f"@{ref.digest}" if ref.digest else "")
    lines[ref.line] = lines[ref.line].replace(old, f"{ref.image}:{ref.tag}@{digest}", 1)
    return "\n".join(lines)


def registry_of(image: str) -> tuple[str, str]:
    """The registry host and the repository of an image name: node is library/node on Docker Hub."""
    first, _, rest = image.partition("/")
    if rest and ("." in first or ":" in first or first == "localhost"):
        host, repository = first, rest
    else:
        host, repository = "docker.io", image
    if host == "docker.io":
        host = "registry-1.docker.io"
        if "/" not in repository:
            repository = f"library/{repository}"
    return host, repository


class Registry:
    """The OCI distribution API of one repository, with an anonymous pull token."""

    def __init__(self, image: str) -> None:
        self.host, self.repository = registry_of(image)
        self.token: str | None = None

    def _open(
        self, url: str, accept: str = "", method: str = "GET"
    ) -> tuple[bytes, dict[str, str]]:
        headers = {"Accept": accept} if accept else {}
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        request = urllib.request.Request(url, headers=headers, method=method)
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT) as answer:
                return answer.read(), dict(answer.headers)
        except urllib.error.HTTPError as error:
            challenge = error.headers.get("WWW-Authenticate", "")
            if error.code != 401 or self.token or not challenge.startswith("Bearer "):
                raise
        self.token = self._fetch_token(challenge)
        return self._open(url, accept, method)

    def _fetch_token(self, challenge: str) -> str:
        fields = dict(re.findall(r'(\w+)="([^"]*)"', challenge))
        query = f"service={fields.get('service', '')}&scope=repository:{self.repository}:pull"
        with urllib.request.urlopen(f"{fields['realm']}?{query}", timeout=TIMEOUT) as answer:
            body = json.loads(answer.read())
        return body.get("token") or body["access_token"]

    def digest(self, tag: str) -> str:
        """The digest TAG points to now: the index of every platform when there is one."""
        url = f"https://{self.host}/v2/{self.repository}/manifests/{tag}"
        ## HEAD, since Docker Hub counts a GET of a manifest as a pull
        _, headers = self._open(url, INDEX_TYPES, "HEAD")
        lowered = {k.lower(): v for k, v in headers.items()}
        return lowered["docker-content-digest"]

    def tags(self) -> list[str]:
        found: list[str] = []
        url: str | None = f"https://{self.host}/v2/{self.repository}/tags/list?n=10000"
        while url:
            body, headers = self._open(url)
            found += json.loads(body).get("tags") or []
            link = {k.lower(): v for k, v in headers.items()}.get("link", "")
            url = f"https://{self.host}{link.split(';')[0].strip('<> ')}" if link else None
        return found


## --- the workflows


def action_pins(text: str) -> list[ActionPin]:
    """Every action pinned to a commit SHA whose line above is a comment with its tag."""
    lines = text.split("\n")
    pins = []
    for index, line in enumerate(lines):
        match = re.fullmatch(r"\s*(?:- )?uses: ([\w.-]+/[\w./-]+)@([0-9a-f]{40})\s*", line)
        if match is None or index == 0:
            continue
        comment = re.fullmatch(r"\s*# (v?\d+(?:\.\d+)*)\s*", lines[index - 1])
        if comment is not None:
            pins.append(ActionPin(index, match[1], comment[1], match[2]))
    return pins


def with_action(text: str, pin: ActionPin, tag: str, sha: str) -> str:
    """TEXT with the action of PIN at SHA and TAG in the comment above it."""
    lines = text.split("\n")
    lines[pin.line] = lines[pin.line].replace(f"@{pin.sha}", f"@{sha}", 1)
    lines[pin.line - 1] = lines[pin.line - 1].replace(f"# {pin.tag}", f"# {tag}", 1)
    return "\n".join(lines)


def remote_tags(action: str) -> dict[str, str]:
    """The tags of an action's repository and the commit each names (an annotated tag peeled)."""
    owner_repo = "/".join(action.split("/")[:2])
    listing = run(["git", "ls-remote", "--tags", f"https://github.com/{owner_repo}"], ROOT)
    tags: dict[str, str] = {}
    for line in listing.splitlines():
        sha, _, ref = line.partition("\t")
        name = ref.removeprefix("refs/tags/")
        if name.endswith("^{}"):
            tags[name.removesuffix("^{}")] = sha
        else:
            tags.setdefault(name, sha)
    return tags


## --- the source of the Bitwarden CLI


def tagged_commit(listing: str, tag: str) -> str | None:
    """The commit TAG names in an ls-remote listing (an annotated tag peeled), None without it."""
    found: dict[str, str] = {}
    for line in listing.splitlines():
        sha, _, ref = line.partition("\t")
        found[ref.strip()] = sha.strip()
    return found.get(f"refs/tags/{tag}^{{}}") or found.get(f"refs/tags/{tag}")


def pinned_cli_version(cli: Path, errors: list[str]) -> str | None:
    """The version of the CLI that package.json in CLI pins, None (and an error) for no X.Y.Z."""
    version = json.loads((cli / "package.json").read_text())["dependencies"][CLI_PACKAGE]
    ## the version goes into a git ref and into docs, so it is only ever plain digits and dots
    if not isinstance(version, str) or not re.fullmatch(r"\d+\.\d+\.\d+", version):
        errors.append(f"{cli / 'package.json'} pins {CLI_PACKAGE} {version!r}, not X.Y.Z")
        return None
    return version


def update_cli_source(cli: Path, version: str, dry_run: bool, errors: list[str]) -> list[Change]:
    """source.json in CLI at the tag of VERSION and the commit it names."""
    path = cli / "source.json"
    source = json.loads(path.read_text())
    tag = f"cli-v{version}"
    ## the repository to ask comes from here, never from the file, as --cli-pin reads the file
    ## from a pull request
    if source.get("repository") != CLI_REPOSITORY:
        named = source.get("repository")
        errors.append(f"{path} names the repository {named!r}, not {CLI_REPOSITORY}")
        return []
    command = ["git", "ls-remote", CLI_REPOSITORY, f"refs/tags/{tag}", f"refs/tags/{tag}^{{}}"]
    try:
        commit = tagged_commit(run(command, ROOT), tag)
    except (SystemExit, subprocess.TimeoutExpired) as error:
        errors.append(f"{CLI_REPOSITORY}: {error}")
        return []
    if commit is None:
        errors.append(f"{CLI_REPOSITORY} has no tag {tag} for {CLI_PACKAGE} {version} ({path})")
        return []
    if (source.get("tag"), source.get("commit")) == (tag, commit):
        return []
    old = f"{source.get('tag')} {str(source.get('commit'))[:7]}"
    if not dry_run:
        source.update(tag=tag, commit=commit)
        path.write_text(json.dumps(source, indent=2) + "\n")
    return [(CLI_REPOSITORY, old, f"{tag} {commit[:7]}")]


def with_cli_version(text: str, pattern: str, version: str) -> tuple[str, list[str]] | None:
    """TEXT with every match of PATTERN stating VERSION and the versions it stated, None when
    nothing matches."""
    found: list[str] = []

    def replace(match: re.Match[str]) -> str:
        found.append(match["version"])
        before = match[0][: match.start("version") - match.start()]
        after = match[0][match.end("version") - match.start() :]
        return before + version + after

    new = re.sub(pattern, replace, text)
    return (new, found) if found else None


def update_cli_docs(root: Path, version: str, dry_run: bool, errors: list[str]) -> list[Change]:
    """The docs of CLI_PIN_DOCS below ROOT stating VERSION."""
    found: list[Change] = []
    for name, pattern in CLI_PIN_DOCS.items():
        path = root / name
        replaced = with_cli_version(path.read_text(), pattern, version)
        if replaced is None:
            errors.append(f"{name} no longer states the CLI version, update CLI_PIN_DOCS")
            continue
        text, old = replaced
        if set(old) == {version}:
            continue
        found.append((name, ", ".join(sorted(set(old))), version))
        if not dry_run:
            path.write_text(text)
    return found


def unsafe_cli_files(root: Path) -> list[str]:
    """The files --cli-pin reads or writes that are a link or lie outside ROOT.

    A pull request could make one a symbolic link, and the write would then land elsewhere.
    """
    names = [
        "docker/bitwarden-cli/package.json",
        "docker/bitwarden-cli/source.json",
        versions.RELEASE_NOTES,
    ]
    unsafe = []
    for name in [*names, *CLI_PIN_DOCS]:
        path = root / name
        if path.is_symlink() or not path.resolve().is_relative_to(root.resolve()):
            unsafe.append(name)
        elif not path.is_file():
            unsafe.append(f"{name} (missing)")
    return unsafe


def cli_note(version: str, pr: int) -> list[str]:
    """The bullet of the release notes for a bump of the CLI to VERSION in pull request PR."""
    link = f"[#{pr}]({versions.REPO_URL}/pull/{pr})"
    return [f"- Run the Bitwarden CLI {version} in the image", f"  ({link})"]


def with_cli_note(text: str, version: str, pr: int) -> str | None:
    """TEXT, the release notes, with the bullet of cli_note under Unreleased, None when it has it.

    The bullet takes the place of "Nothing yet." or comes last. A bullet of the same pull request
    for another version is replaced, so the notes never name the CLI twice for it.
    """
    lines = text.splitlines()
    heading = f"## {versions.UNRELEASED}"
    if heading not in lines:
        return None
    start = lines.index(heading) + 1
    end = next(
        (i for i in range(start, len(lines)) if lines[i].startswith("## ")),
        len(lines),
    )
    bullet = cli_note(version, pr)
    link = bullet[1].strip()
    index = start
    while index < end:
        if lines[index].startswith("- Run the Bitwarden CLI "):
            stop = index + 1
            while stop < end and lines[stop].startswith(" "):
                stop += 1
            if link in " ".join(lines[index:stop]):
                if lines[index:stop] == bullet:
                    return None
                lines[index:stop] = bullet
                return "\n".join(lines) + "\n"
            index = stop
        else:
            index += 1
    section = lines[start:end]
    if versions.NOTHING_YET in section:
        at = start + section.index(versions.NOTHING_YET)
        lines[at : at + 1] = bullet
    else:
        last = max(i for i in range(start, end) if lines[i].strip())
        lines[last + 1 : last + 1] = bullet
    return "\n".join(lines) + "\n"


def update_cli_note(root: Path, version: str, pr: int, dry_run: bool) -> list[Change]:
    """The bullet of cli_note in the release notes below ROOT."""
    path = root / versions.RELEASE_NOTES
    text = with_cli_note(path.read_text(), version, pr)
    if text is None:
        return []
    if not dry_run:
        path.write_text(text)
    return [
        (f"{versions.RELEASE_NOTES} ({versions.UNRELEASED})", None, cli_note(version, pr)[0][2:])
    ]


def update_cli_pin(
    root: Path, dry_run: bool, errors: list[str], pr: int | None = None
) -> list[Change]:
    """Every place below ROOT that states the CLI version package.json pins: source.json and the
    docs of CLI_PIN_DOCS, and with PR (its pull request) the bullet of the release notes."""
    unsafe = unsafe_cli_files(root)
    if unsafe:
        errors.append(f"not a regular file in {root}: {', '.join(unsafe)}")
        return []
    cli = root / "docker" / "bitwarden-cli"
    version = pinned_cli_version(cli, errors)
    if version is None:
        return []
    known = len(errors)
    source = update_cli_source(cli, version, dry_run, errors)
    ## docs that name a version whose source is unknown would be wrong, so they wait for it
    if len(errors) > known:
        return []
    docs = update_cli_docs(root, version, dry_run, errors)
    if pr is None or len(errors) > known:
        return source + docs
    return source + docs + update_cli_note(root, version, pr, dry_run)


## --- the lock files


def uv_versions(text: str) -> dict[str, str]:
    """Every package of a uv.lock and its version, the project itself left out."""
    lock = tomllib.loads(text)
    return {
        p["name"]: p["version"]
        for p in lock.get("package", [])
        if "version" in p and p.get("source", {}).get("editable") != "."
    }


def npm_versions(text: str) -> dict[str, str]:
    """Every package of a package-lock.json and its version, by its path below node_modules."""
    packages = json.loads(text).get("packages", {})
    return {
        path.removeprefix("node_modules/"): entry["version"]
        for path, entry in packages.items()
        if path and "version" in entry and not entry.get("link")
    }


def changes(before: dict[str, str], after: dict[str, str]) -> list[Change]:
    """What differs between two listings of packages, by name."""
    names = sorted(set(before) | set(after))
    return [(n, before.get(n), after.get(n)) for n in names if before.get(n) != after.get(n)]


def uv_dry_run_changes(output: str) -> list[Change]:
    """The changes `uv lock --upgrade --dry-run` prints: Update, Add and Remove lines."""
    found: list[Change] = []
    for line in output.splitlines():
        if match := re.fullmatch(r"Update (\S+) v(\S+) -> v(\S+)", line.strip()):
            found.append((match[1], match[2], match[3]))
        elif match := re.fullmatch(r"Add (\S+) v(\S+)", line.strip()):
            found.append((match[1], None, match[2]))
        elif match := re.fullmatch(r"Remove (\S+) v(\S+)", line.strip()):
            found.append((match[1], match[2], None))
    return sorted(found)


def uv_outdated(output: str) -> list[tuple[str, str, str]]:
    """The direct dependencies `uv tree --outdated --depth 1` marks: (name, locked, latest)."""
    found = []
    for line in output.splitlines():
        match = re.search(r"(\S+) v(\S+)(?: \([^)]*\))*? \(latest: v(\S+)\)", line)
        if match:
            found.append((match[1], match[2], match[3]))
    return found


def npm_outside(outdated: dict) -> list[tuple[str, str, str]]:
    """The packages of `npm outdated --json` whose latest version is outside the range."""
    return sorted(
        (name, entry.get("wanted", "?"), entry["latest"])
        for name, entry in outdated.items()
        if entry.get("latest") and entry.get("latest") != entry.get("wanted")
    )


## --- running it


def run(command: list[str], cwd: Path, check: bool = True) -> str:
    """COMMAND's output, with a time limit, since most of them reach the network."""
    result = subprocess.run(
        command, cwd=cwd, capture_output=True, text=True, timeout=TIMEOUT * 5, check=False
    )
    if check and result.returncode != 0:
        raise SystemExit(f"update-deps: {' '.join(command)} failed:\n{result.stderr.strip()}")
    return result.stdout + result.stderr


def update_uv(project: Path, dry_run: bool) -> list[Change]:
    """uv lock --upgrade in PROJECT (backend or demo), a dry run writes nothing."""
    lock = project / "uv.lock"
    if dry_run:
        return uv_dry_run_changes(run(["uv", "lock", "--upgrade", "--dry-run"], project))
    before = uv_versions(lock.read_text())
    run(["uv", "lock", "--upgrade"], project)
    return changes(before, uv_versions(lock.read_text()))


def update_npm(project: Path, dry_run: bool, install: bool) -> list[Change]:
    """npm update within the ranges, in a copy for a dry run, and npm ci when INSTALL."""
    lock = project / "package-lock.json"
    before = npm_versions(lock.read_text())
    with tempfile.TemporaryDirectory(prefix="update-deps-") as tmp:
        where = Path(tmp) if dry_run else project
        if dry_run:
            for name in ("package.json", "package-lock.json"):
                shutil.copy(project / name, where / name)
        flags = ["--no-fund", "--no-audit"]
        if dry_run or not install:
            flags += ["--package-lock-only", "--ignore-scripts"]
        run(["npm", "update", *flags], where)
        after = npm_versions((where / "package-lock.json").read_text())
    if install and not dry_run:
        run(["npm", "ci", "--no-fund", "--no-audit"], project)
    return changes(before, after)


def update_images(dry_run: bool, outside: list[str], errors: list[str]) -> list[Change]:
    found: list[Change] = []
    ## an image two files name (uv, the Dockerfile syntax) is looked up once and listed once
    known: dict[str, tuple[str, list[str]]] = {}
    failed: set[str] = set()
    for path in IMAGE_FILES:
        text = path.read_text()
        for ref in image_refs(text):
            name = f"{ref.image}:{ref.tag}"
            if name in failed:
                continue
            try:
                if name not in known:
                    registry = Registry(ref.image)
                    known[name] = (registry.digest(ref.tag), newer_tags(ref.tag, registry.tags()))
            except (OSError, KeyError, ValueError) as error:
                errors.append(f"{name}: {error}")
                failed.add(name)
                continue
            digest, newer = known[name]
            if digest != ref.digest:
                change = (name, ref.digest, digest)
                if change not in found:
                    found.append(change)
                text = with_digest(text, ref, digest)
            note = f"image {name}: newer tag {ref.image}:{newer[-1]}" if newer else ""
            if note and note not in outside:
                outside.append(note)
        if not dry_run:
            path.write_text(text)
    return found


def update_actions(dry_run: bool, outside: list[str], errors: list[str]) -> list[Change]:
    found: list[Change] = []
    known: dict[str, dict[str, str]] = {}
    for workflow in sorted(WORKFLOWS.glob("*.yml")):
        text = workflow.read_text()
        for pin in action_pins(text):
            try:
                tags = known.get(pin.action) or remote_tags(pin.action)
            except (SystemExit, subprocess.TimeoutExpired) as error:
                errors.append(f"{pin.action}: {error}")
                continue
            known[pin.action] = tags
            tag = newest_in_major(pin.tag, list(tags))
            if tags.get(tag, pin.sha) != pin.sha or tag != pin.tag:
                change = (pin.action, f"{pin.tag} {pin.sha[:7]}", f"{tag} {tags[tag][:7]}")
                if change not in found:
                    found.append(change)
                text = with_action(text, pin, tag, tags[tag])
            newer = newer_majors(pin.tag, list(tags))
            note = f"action {pin.action} {pin.tag}: newer major {newer[-1]}" if newer else ""
            if note and note not in outside:
                outside.append(note)
        if not dry_run:
            workflow.write_text(text)
    return found


def outside_packages(
    outside: list[str], backend_changes: list[Change], demo_changes: list[Change]
) -> None:
    """Add the packages whose latest version lies outside the ranges, after the update."""
    ## in a dry run the lock is not upgraded yet, so a latest version the upgrade reaches is not
    ## outside its range
    for label, project, project_changes in (
        ("backend", BACKEND, backend_changes),
        ("demo", DEMO, demo_changes),
    ):
        reached = {name: new for name, _, new in project_changes}
        tree = run(["uv", "tree", "--outdated", "--depth", "1", "--frozen"], project, check=False)
        for name, locked, latest in uv_outdated(tree):
            if reached.get(name) != latest:
                outside.append(f"{label} {name} {reached.get(name, locked)}: latest {latest}")
    for label, project in (
        ("frontend", FRONTEND),
        ("bitwarden-cli", CLI),
        ("markdownlint", MARKDOWNLINT),
    ):
        answer = run(["npm", "outdated", "--json"], project, check=False)
        start = answer.find("{")
        outdated = json.loads(answer[start:]) if start >= 0 else {}
        for name, wanted, latest in npm_outside(outdated):
            outside.append(f"{label} {name} {wanted}: latest {latest}")


def print_changes(label: str, found: list[Change]) -> None:
    if not found:
        print(f"{label}: no change")
        return
    print(f"{label}:")
    for name, old, new in found:
        print(f"  {name} {old or '(new)'} -> {new or '(removed)'}")


def cli_pin_main(root: Path, dry_run: bool, pr: int | None) -> int:
    """--cli-pin: write the CLI pin below ROOT and print what changed."""
    errors: list[str] = []
    found = update_cli_pin(root, dry_run, errors, pr)
    print("Would change:" if dry_run else "Changed:")
    print_changes("Bitwarden CLI pin", found)
    for error in errors:
        print(f"update-deps: {error}", file=sys.stderr)
    return 1 if errors else 0


def cli_pin_args(args: list[str], dry_run: bool) -> int:
    """--cli-pin with its options --root DIR and --pr N, each at most once."""
    options: dict[str, str] = {}
    while args:
        if len(args) < 2 or args[0] not in ("--root", "--pr") or args[0] in options:
            print(__doc__, file=sys.stderr)
            return 2
        options[args[0]] = args[1]
        args = args[2:]
    pr = options.get("--pr")
    ## the number goes into the release notes, so it is only ever digits
    if pr is not None and not re.fullmatch(r"[1-9]\d*", pr):
        print(f"update-deps: --pr takes the number of a pull request, not {pr!r}", file=sys.stderr)
        return 2
    root = Path(options["--root"]) if "--root" in options else ROOT
    return cli_pin_main(root, dry_run, int(pr) if pr is not None else None)


def main(args: list[str]) -> int:
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    dry_run = "--dry-run" in args
    rest = [arg for arg in args if arg != "--dry-run"]
    if rest[:1] == ["--cli-pin"]:
        return cli_pin_args(rest[1:], dry_run)
    if rest:
        print(__doc__, file=sys.stderr)
        return 2
    outside: list[str] = []
    errors: list[str] = []
    found = {
        "backend (backend/uv.lock)": update_uv(BACKEND, dry_run),
        "demo (demo/uv.lock)": update_uv(DEMO, dry_run),
        "frontend (frontend/package-lock.json)": update_npm(FRONTEND, dry_run, install=True),
        "Bitwarden CLI (docker/bitwarden-cli/package-lock.json)": update_npm(
            CLI, dry_run, install=False
        ),
        "Bitwarden CLI pin (docker/bitwarden-cli/source.json and the docs)": update_cli_pin(
            ROOT, dry_run, errors
        ),
        "markdownlint (tools/markdownlint/package-lock.json)": update_npm(
            MARKDOWNLINT, dry_run, install=False
        ),
        "images (Dockerfile, demo/Dockerfile, compose.demo.yaml)": update_images(
            dry_run, outside, errors
        ),
        "actions (.github/workflows)": update_actions(dry_run, outside, errors),
    }
    outside_packages(outside, found["backend (backend/uv.lock)"], found["demo (demo/uv.lock)"])
    if not dry_run:
        run([str(SCRIPTS / "third-party")], ROOT)
        mismatch = versions.version_mismatch()
        if mismatch:
            errors.append(mismatch)
    print("Would change:" if dry_run else "Changed:")
    for label, changed in found.items():
        print_changes(label, changed)
    print("Outside the ranges, for a human to decide (not applied):")
    for line in outside or ["nothing"]:
        print(f"  {line}")
    for error in errors:
        print(f"update-deps: {error}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
