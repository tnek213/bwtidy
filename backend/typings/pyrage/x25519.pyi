class Recipient:
    @classmethod
    def from_str(cls, v: str) -> Recipient: ...
    def __str__(self) -> str: ...

class Identity:
    @classmethod
    def generate(cls) -> Identity: ...
    @classmethod
    def from_str(cls, v: str) -> Identity: ...
    def to_public(self) -> Recipient: ...
    def __str__(self) -> str: ...
